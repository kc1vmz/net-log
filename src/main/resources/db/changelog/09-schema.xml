<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">
  <changeSet id="09" author="kc1vmz">
    <createTable tableName="district">
      <column name="id" type="VARCHAR(36)">
        <constraints nullable="false" unique="true" primaryKey="true"/>
      </column>
      <column name="section_id" type="VARCHAR(36)">
        <constraints nullable="false" unique="false"/>
      </column>
      <column name="name" type="VARCHAR(100)">
        <constraints nullable="false" unique="false"/>
      </column>
      <column name="description" type="VARCHAR(100)">
        <constraints nullable="true" unique="false"/>
      </column>
      <column name="leader_name" type="VARCHAR(100)">
        <constraints nullable="true" unique="false"/>
      </column>
      <column name="leader_contact" type="VARCHAR(100)">
        <constraints nullable="true" unique="false"/>
      </column>
    </createTable>
    <createTable tableName="district_location">
      <column name="id" type="VARCHAR(36)">
        <constraints nullable="false" unique="true" primaryKey="true"/>
      </column>
      <column name="section_id" type="VARCHAR(36)">
        <constraints nullable="false" unique="false"/>
      </column>
      <column name="district_id" type="VARCHAR(36)">
        <constraints nullable="false" unique="false"/>
      </column>
      <column name="location_id" type="VARCHAR(36)">
        <constraints nullable="false" unique="false"/>
      </column>
    </createTable>
  </changeSet>
</databaseChangeLog>