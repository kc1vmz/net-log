<html>
<head>
  <meta charset="utf-8"><meta name="viewport" content="initial-scale=1, width=device-width">
  <meta name="robots" content="noindex, nofollow">
  <title>NetLog - Check-ins for Active Event - {{event.name}}</title>
</head>
<body>
<style>

body {
    margin: 0px;
    background: #2559a7;
    color: #ddd;
  }

.navbar {
  overflow: hidden;
  background-color: #2559a7;
  position: fixed; /* Set the navbar to fixed position */
  top: 0; /* Position the navbar at the top of the page */
  width: 100%; /* Full width */
}

/* Links inside the navbar */
.navbar a {
  float: left;
  display: block;
  background-color: #2559a7;
  color: #ddd;
  text-align: center;
  padding: 14px 16px;
  text-decoration: none;

  font-family: -apple-system, "Helvetica Neue", Helvetica, sans-serif;
  -webkit-font-smoothing: antialiased;
  font-style: normal;
  letter-spacing: -0.0025em;
  place-items: center;
  text-rendering: optimizeLegibility;
  -webkit-text-size-adjust: 100%;

}

/* Change background on mouse-over */
.navbar a:hover {
  background: #ddd;
  color: black;
}

/* Main content */
.main {
  margin-top: 60px;
  font-family: -apple-system, "Helvetica Neue", Helvetica, sans-serif;
  /* font-size: clamp(1rem, 2.5vw, 2rem); */
  -webkit-font-smoothing: antialiased;
  font-style: normal;
  font-weight: 400;
  letter-spacing: -0.0025em;
  line-height: 1.4;
  min-height: 100vh;
  /* place-items: center; */
  text-rendering: optimizeLegibility;
  -webkit-text-size-adjust: 100%;
}

.grid-container {
  display: grid;
  grid-template-columns: 25% 25% 25% 25%;
  margin: 20px;
  gap: 20px;
}
.grid-item {
}

.line {
  margin : 20px;
}

    .main a {
        color: #ddd;
    }

    .grid-membership-container {
      display: grid;
      grid-template-columns: 30% 30% 40%;
      margin: 0px;
      gap: 20px;
    }
    .grid-membership-item {
    }

    .table-container {
        max-height: 500px;
        overflow-y: auto;
    }
    table {
        border-collapse: collapse;
    }
    thead, tbody {
    }
    thead {
    }
    tbody {
        max-height: 450px;
        overflow-y: auto;
    }
    td {
        padding: 3px;
        text-align: left;
        border: 1px solid #ddd;
        box-sizing: border-box;
        color: #ddd;
        background-color: #2559a7
    }
    th{
        padding: 3px;
        text-align: left;
        border: 1px solid #ddd;
        box-sizing: border-box;
        background-color: #ddd;
        color: #2559a7
    }
    .rowpadded {
        height:20px;
    }
    .column75 {
        float: left;
        width: 75%;
    }
    .column90 {
        float: left;
        width: 90%;
    }
    .column25 {
        float: left;
        width: 25%;
    }
    .column10 {
        float: left;
        width: 10%;
    }

  .block {
    border: 1px;
    background: #033684;
    color: white;
    padding: 5px 10px;
    font-size: 16px;
    cursor: pointer;
    text-align: center;
    text-decoration: none;
  }

  .block:hover {
    background: #ddd;
    color: black;
  }
</style>

<script>

  var participants =  '';

  function addMember(id) {
    moveMember(id, 'assigned')
  }

  function removeMember(id) {
    moveMember(id, 'available')
  }

  function addId(id, checkInTime) {
    participants += (id + ',' + checkInTime+ ',');
    setIds();
  }

  function setIds() {
    tempString = document.querySelector('#participantIds');
    tempString.value = participants;
  }

  function removeId(id) {
    if ((participants === null) || (participants === '')) {
      setIds();
      return;
    }
    let newIds = '';
    var values = participants.split(",");
    // need to loop through ID,time,
    for (let i = 0; i < values.length-1; i+=2) {
      let idList = values[i];
      if (idList != id) {
        newIds += (idList + ',' + values[i+1] + ',');
      }
    }
    participants = newIds;
    setIds();
  }

  function moveMember(rowId, target) {

    const row = document.getElementById(rowId);
    if (!row) return;

    let targetTableBody;
    let newButtonAction;
    let newButtonText;

    if (target === 'assigned') {
        targetTableBody = document.querySelector('#participant-list tbody');
        newButtonAction = 'removeMember(\'' + rowId +'\')';
        newButtonText = 'Remove';
        const timeCell = row.cells[row.cells.length-2];
        var timeStr = timeCell.childNodes[0].value;
        timeCell.childNodes[0].readOnly = true;
        addId(rowId, timeStr);
    } else if (target === 'available') {
        targetTableBody = document.querySelector('#operator-list tbody');
        newButtonAction = 'addMember(\'' + rowId + '\')';
        newButtonText = 'Check-in';
        const timeCell = row.cells[row.cells.length-2];
        timeCell.childNodes[0].readOnly = false;
        removeId(rowId);
    }

    if (targetTableBody) {
        // Find the button cell (the second cell) and update its action and text
        const buttonCell = row.cells[row.cells.length-1];
        if (buttonCell) {
            buttonCell.innerHTML = ''; // Clear existing button
            const newButton = document.createElement('button');
            newButton.onclick = new Function(newButtonAction);
            newButton.textContent = newButtonText;
            newButton.classList.add('move-btn');
            buttonCell.appendChild(newButton);
        }
        
        // Move the row to the new table
        targetTableBody.appendChild(row);
    }
  }

</script>

<div>
  <div class="navbar">
    <a href="/">Welcome</a>
    <a href="/activeEvents"><b>Active Events</b></a>
    <a href="/recurringEvents">Recurring Events</a>
    <a href="/archives">Archives</a>
    <a href="/sections">Sections</a>
    <a href="/operators">Operators</a>
  </div>
  <div class="main">
    <div><hr/></div>
    <div style="margin:20px;">
    <h1>Check-ins for Active Event - {{event.name}}</h1>
    <p>Check-in operators to this event, including their check-in time.
    <div class="line" style="margin:0px"><hr/></div>
    </div>

    <div style="margin:20px;">
      <form action="/activeEvent-checkin-action/{{event.id}}" method="post">
        <input type="hidden" name="participantIds" id="participantIds" class="form-control"/>

        <div class="grid-membership-container"  style="margin:20px;">
          <div class="grid-membership-item">
            <div class="table-container" >
              <h3>Participants to check-in</h3>
              <table id="participant-list">
                <thead>
                  <tr>
                    <th>Callsign</th>
                    <th>Name</th>
                    <th>Check-in time</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  {{#each participants}}
                    <tr id="{{operator.id}}">
                      <td>{{operator.callsign}}</td>
                      <td>{{operator.name}}</td>
                      <td><input type="text" id="checkInTimeStr" class="form-control"/></td>
                      <td><button onclick='removeMember("{{operator.id}}")'>Check-out</button></td>
                    </tr>
                  {{/each}}
                </tbody>
              </table>
            </div>
          </div>
          <div class="grid-membership-item">
            <div class="table-container" >
              <h3>Previous participants</h3>
              <table id="previous-list">
                <thead>
                  <tr>
                    <th>Callsign</th>
                    <th>Name</th>
                    <th>Check-in time</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  {{#each previousOperators}}
                    <tr id="{{id}}">
                      <td>{{callsign}}</td>
                      <td>{{name}}</td>
                      <td><input type="text" id="checkInTimeStr" value="{{checkInTimeStr}}" class="form-control"/></td>
                      <td><button onclick='addMember("{{id}}")'>Check-in</button></td>
                    </tr>
                  {{/each}}
                </tbody>
              </table>
            </div>
          </div>
          <div class="grid-membership-item">
            <div class="table-container" >
              <h3>Potential participants</h3>
              <table id="operator-list">
                <thead>
                  <tr>
                    <th>Callsign</th>
                    <th>Name</th>
                    <th>Check-in time</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  {{#each operators}}
                    <tr id="{{id}}">
                      <td>{{callsign}}</td>
                      <td>{{name}}</td>
                      <td><input type="text" id="checkInTimeStr" value="{{checkInTimeStr}}" class="form-control"/></td>
                      <td><button onclick='addMember("{{id}}")'>Check-in</button></td>
                    </tr>
                  {{/each}}
                </tbody>
              </table>
            </div>
          </div>
        <!-- end grid -->
        </div>

        <div class="line" style="margin:0px"><hr/></div>
        <div>
          <input type="submit" value="Update" class="btn btn-primary block"/>
          <a class="block" href="/activeEvent/{{event.id}}">Cancel</a>
        </div>
      </form>
    </div>
  </div>
  </div>
</div>

</body>
</html>