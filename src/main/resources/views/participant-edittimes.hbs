<html>
<head>
  <meta charset="utf-8"><meta name="viewport" content="initial-scale=1, width=device-width">
  <meta name="robots" content="noindex, nofollow">
  <title>NetLog - Update Participant - {{participant.operator.callsign}}</title>
</head>
<body>
<style>

body {
    margin: 0px;
    background: #2559a7;
    color: #ddd;
  }

.navbar {
  overflow: hidden;
  background-color: #2559a7;
  position: fixed; /* Set the navbar to fixed position */
  top: 0; /* Position the navbar at the top of the page */
  width: 100%; /* Full width */
}

/* Links inside the navbar */
.navbar a {
  float: left;
  display: block;
  background-color: #2559a7;
  color: #ddd;
  text-align: center;
  padding: 14px 16px;
  text-decoration: none;

  font-family: -apple-system, "Helvetica Neue", Helvetica, sans-serif;
  -webkit-font-smoothing: antialiased;
  font-style: normal;
  letter-spacing: -0.0025em;
  place-items: center;
  text-rendering: optimizeLegibility;
  -webkit-text-size-adjust: 100%;

}

/* Change background on mouse-over */
.navbar a:hover {
  background: #ddd;
  color: black;
}

/* Main content */
.main {
  margin-top: 60px;
  font-family: -apple-system, "Helvetica Neue", Helvetica, sans-serif;
  /* font-size: clamp(1rem, 2.5vw, 2rem); */
  -webkit-font-smoothing: antialiased;
  font-style: normal;
  font-weight: 400;
  letter-spacing: -0.0025em;
  line-height: 1.4;
  min-height: 100vh;
  /* place-items: center; */
  text-rendering: optimizeLegibility;
  -webkit-text-size-adjust: 100%;
}

.grid-container {
  display: grid;
  grid-template-columns: 50%  50%;
  margin: 20px;
  gap: 20px;
}
.grid-item {
}

.line {
  margin : 20px;
}

    .main a {
        color: #ddd;
    }

    .grid-membership-container {
      display: grid;
      grid-template-columns: 30% 30% 40%;
      margin: 0px;
      gap: 20px;
    }
    .grid-membership-item {
    }

    .table-container {
        max-height: 500px;
        overflow-y: auto;
    }
    table {
        border-collapse: collapse;
    }
    thead, tbody {
    }
    thead {
    }
    tbody {
        max-height: 450px;
        overflow-y: auto;
    }
    td {
        padding: 3px;
        text-align: left;
        border: 1px solid #ddd;
        box-sizing: border-box;
        color: #ddd;
        background-color: #2559a7
    }
    th{
        padding: 3px;
        text-align: left;
        border: 1px solid #ddd;
        box-sizing: border-box;
        background-color: #ddd;
        color: #2559a7
    }
    .rowpadded {
        height:20px;
    }
    .column75 {
        float: left;
        width: 75%;
    }
    .column90 {
        float: left;
        width: 90%;
    }
    .column25 {
        float: left;
        width: 25%;
    }
    .column10 {
        float: left;
        width: 10%;
    }

  .block {
    border: 1px;
    background: #033684;
    color: white;
    padding: 5px 10px;
    font-size: 16px;
    cursor: pointer;
    text-align: center;
    text-decoration: none;
  }

  .block:hover {
    background: #ddd;
    color: black;
  }
</style>

<script>
</script>

<div>
  <div class="navbar">
    <a href="/">Welcome</a>
    <a href="/activeEvents"><b>Active Events</b></a>
    <a href="/recurringEvents">Recurring Events</a>
    <a href="/archives">Archives</a>
    <a href="/sections">Sections</a>
    <a href="/operators">Operators</a>
  </div>
  <div class="main">
    <div><hr/></div>
    <div style="margin:20px;">
    <h1>Update Participant Details - {{participant.operator.callsign}}</h1>
    <p>Update details such as power sources, transmit power, check-in and check-out times.
    <div class="line" style="margin:0px"><hr/></div>
    </div>

    <div style="margin:20px;">
      <form action="/participant-edittimes-action/{{participant.id}}" method="post">
        <div class="mb-3">
            <label for="startTimeStr" class="form-label">Start time:</label>
            <input type="datetime-local" name="startTimeStr" id="startTimeStr" value="{{participant.startTime}}" class="form-control"/>
        </div>
        {{#if showEndTime}}
        <div class="mb-3">
            <label for="endTimeStr" class="form-label">End time:</label>
            <input type="datetime-local" name="endTimeStr" id="endTimeStr" value="{{participant.endTime}}" class="form-control"/>
        </div>
        {{/if}}
        <div class="mb-3">
            <label for="transmitPower" class="form-label">Transmit power:</label>
            <input type="number" name="transmitPower" id="transmitPower" value="{{participant.transmitPower}}" class="form-control" min="0"/>
        </div>
        <div>
            <label for="primaryPowerSource" class="form-label">Primary power source:</label>
            <select name="primaryPowerSource" id="primaryPowerSource">
              {{#if primaryPowerSource0}}
              <option value="0" selected>Unknown</option>
              {{else}}
              <option value="0">Unknown</option>
              {{/if}}
              {{#if primaryPowerSource1}}
              <option value="1" selected>Commercial</option>
              {{else}}
              <option value="1">Commercial</option>
              {{/if}}
              {{#if primaryPowerSource2}}
              <option value="2" selected>Generator</option>
              {{else}}
              <option value="2">Generator</option>
              {{/if}}
              {{#if primaryPowerSource3}}
              <option value="3" selected>Solar</option>
              {{else}}
              <option value="3">Solar</option>
              {{/if}}
              {{#if primaryPowerSource4}}
              <option value="4" selected>Battery</option>
              {{else}}
              <option value="4">Battery</option>
              {{/if}}
              {{#if primaryPowerSource5}}
              <option value="5" selected>Other</option>
              {{else}}
              <option value="5">Other</option>
              {{/if}}
              {{#if primaryPowerSource6}}
              <option value="6" selected>None</option>
              {{else}}
              <option value="6">None</option>
              {{/if}}
            </select>
        </div>
        <div>
            <label for="secondaryPowerSource" class="form-label">Secondary power source:</label>
            <select name="secondaryPowerSource" id="secondaryPowerSource">
              {{#if secondaryPowerSource0}}
              <option value="0" selected>Unknown</option>
              {{else}}
              <option value="0">Unknown</option>
              {{/if}}
              {{#if secondaryPowerSource1}}
              <option value="1" selected>Commercial</option>
              {{else}}
              <option value="1">Commercial</option>
              {{/if}}
              {{#if secondaryPowerSource2}}
              <option value="2" selected>Generator</option>
              {{else}}
              <option value="2">Generator</option>
              {{/if}}
              {{#if secondaryPowerSource3}}
              <option value="3" selected>Solar</option>
              {{else}}
              <option value="3">Solar</option>
              {{/if}}
              {{#if secondaryPowerSource4}}
              <option value="4" selected>Battery</option>
              {{else}}
              <option value="4">Battery</option>
              {{/if}}
              {{#if secondaryPowerSource5}}
              <option value="5" selected>Other</option>
              {{else}}
              <option value="5">Other</option>
              {{/if}}
              {{#if secondaryPowerSource6}}
              <option value="6" selected>None</option>
              {{else}}
              <option value="6">None</option>
              {{/if}}
            </select>
        </div>
        <div class="line" style="margin:0px"><hr/></div>
        <div>
          <input type="submit" value="Update" class="btn btn-primary block"/>
          <a class="block" href="/activeEvent/{{participant.event.id}}">Cancel</a>
        </div>
      </form>
    </div>
  </div>
  </div>
</div>

</body>
</html>