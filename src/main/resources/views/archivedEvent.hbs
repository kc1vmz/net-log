<html>
<head>
  <meta charset="utf-8"><meta name="viewport" content="initial-scale=1, width=device-width">
  <meta name="robots" content="noindex, nofollow">
  <title>NetLog - Archived Event - {{event.name}} @ {{event.prettyStartTime}} </title>
</head>
<body>
<style>

body {
    margin: 0px;
    background: #2559a7;
    color: #ddd;
  }

.navbar {
  overflow: hidden;
  background-color: #2559a7;
  position: fixed; /* Set the navbar to fixed position */
  top: 0; /* Position the navbar at the top of the page */
  width: 100%; /* Full width */
}

/* Links inside the navbar */
.navbar a {
  float: left;
  display: block;
  background-color: #2559a7;
  color: #ddd;
  text-align: center;
  padding: 14px 16px;
  text-decoration: none;

  font-family: -apple-system, "Helvetica Neue", Helvetica, sans-serif;
  -webkit-font-smoothing: antialiased;
  font-style: normal;
  letter-spacing: -0.0025em;
  place-items: center;
  text-rendering: optimizeLegibility;
  -webkit-text-size-adjust: 100%;

}

/* Change background on mouse-over */
.navbar a:hover {
  background: #ddd;
  color: black;
}

/* Main content */
.main {
  margin-top: 60px;
  font-family: -apple-system, "Helvetica Neue", Helvetica, sans-serif;
  /* font-size: clamp(1rem, 2.5vw, 2rem); */
  -webkit-font-smoothing: antialiased;
  font-style: normal;
  font-weight: 400;
  letter-spacing: -0.0025em;
  line-height: 1.4;
  min-height: 100vh;
  /* place-items: center; */
  text-rendering: optimizeLegibility;
  -webkit-text-size-adjust: 100%;
}

.grid-container {
  display: grid;
  grid-template-columns: 50%  50%;
  margin: 20px;
  gap: 20px;
}
.grid-item {
}

.line {
  margin : 20px;
}

    .main a {
        color: #ddd;
    }





    .table-container {
        max-height: 500px;
        overflow-y: auto;
    }
    table {
        border-collapse: collapse;
    }
    thead, tbody {
    }
    thead {
    }
    tbody {
        max-height: 450px;
        overflow-y: auto;
    }
    td {
        padding: 3px;
        text-align: left;
        border: 1px solid #ddd;
        box-sizing: border-box;
        color: #ddd;
        background-color: #2559a7
    }
    th{
        padding: 3px;
        text-align: left;
        border: 1px solid #ddd;
        box-sizing: border-box;
        background-color: #ddd;
        color: #2559a7
    }
    .rowpadded {
        height:20px;
    }
    .column75 {
        float: left;
        width: 75%;
    }
    .column90 {
        float: left;
        width: 90%;
    }
    .column25 {
        float: left;
        width: 25%;
    }
    .column10 {
        float: left;
        width: 10%;
    }

  .block {
    border: 1px;
    background: #033684;
    color: white;
    padding: 5px 10px;
    font-size: 16px;
    cursor: pointer;
    text-align: center;
    text-decoration: none;
  }

  .block:hover {
    background: #ddd;
    color: black;
  }

</style>

<script>
</script>

<div>
  <div class="navbar">
    <a href="/">Welcome</a>
    <a href="/activeEvents">Active Events</a>
    <a href="/recurringEvents">Recurring Events</a>
    <a href="/archives"><b>Archives</b></a>
    <a href="/sections">Sections</a>
    <a href="/operators">Operators</a>
  </div>
  <div class="main">
    <div><hr/></div>
    <div style="margin:20px;">
    <h1>Archived Event Details - {{event.name}} @ {{event.prettyStartTime}} </h1>
    <p>View properties of an archived event, including its location, start and end times and participants.
    <div class="line" style="margin:0px"><hr/></div>
    </div>
    <div style="margin:20px;">
      <div>
        <p><b>Name</b>:
        {{event.name}}
      </div>
      <div>
        <p><b>Description</b>:
        {{event.description}}
      </div>
      <div>
        <p><b>Type</b>:
        {{event.type}}
      </div>
      <div>
        <p><b>State</b>:
        {{event.state}}
      </div>
      <div>
        <p><b>Location</b>:
        {{event.location}}
      </div>
      <div>
        <p><b>Start time</b>:
        {{event.prettyStartTime}}
      </div>
      <div>
        <p><b>End time</b>:
        {{event.prettyEndTime}}
      </div>
      <div>
        <p><b>Section</b>:
        {{event.section.name}}
      </div>
      <div>
        <p><b>Net Control callsign</b>:
        {{event.netControlCallsign}}
      </div>
      <div class="table-container">
        <b>Participants ({{participantCount}} total)</b>
        <table id="members-list">
          <thead>
            <tr>
              <th>Callsign</th>
              <th>Name</th>
              <th>Type</th>
              <th>NTS?</th>
              <th>Skywarn?</th>
              <th>Check-in Time</th>
              <th>Check-out Time</th>
              <th>Transmit Power</th>
              <th>Primary Power Source</th>
              <th>Secondary Power Source</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            {{#each participants}}
              <tr id="{{id}}">
                <td>{{operator.callsign}}</td>
                <td>{{operator.name}}</td>
                <td>{{membershipType}}</td>
                <td>{{operator.isNTS}}</td>
                <td>{{operator.isSkywarn}}</td>
                <td>{{prettyStartTime}}</td>
                <td>{{prettyEndTime}}</td>
                <td>{{transmitPower}}</td>
                <td>{{primaryPower}}</td>
                <td>{{backupPower}}</td>
                <td><a href="/participant-edittimes/{{id}}">Update</a></td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
      <div class="line" style="margin:0px"><hr/></div>
      <a class="block" href="/archivedEvent-report/{{event.id}}">Generate report</a>
      &nbsp;<a class="block" href="/archives">Back to archived events</a>
    </div>
  </div>
  </div>
</div>

</body>
</html>