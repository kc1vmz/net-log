<html>
<head>
  <meta charset="utf-8"><meta name="viewport" content="initial-scale=1, width=device-width">
  <meta name="robots" content="noindex, nofollow">
  <title>NetLog - Section - {{section.name}} </title>
</head>
<body>
<style>

body {
    margin: 0px;
    background: #2559a7;
    color: #ddd;
  }

.navbar {
  overflow: hidden;
  background-color: #2559a7;
  position: fixed; /* Set the navbar to fixed position */
  top: 0; /* Position the navbar at the top of the page */
  width: 100%; /* Full width */
}

/* Links inside the navbar */
.navbar a {
  float: left;
  display: block;
  background-color: #2559a7;
  color: #ddd;
  text-align: center;
  padding: 14px 16px;
  text-decoration: none;

  font-family: -apple-system, "Helvetica Neue", Helvetica, sans-serif;
  -webkit-font-smoothing: antialiased;
  font-style: normal;
  letter-spacing: -0.0025em;
  place-items: center;
  text-rendering: optimizeLegibility;
  -webkit-text-size-adjust: 100%;

}

/* Change background on mouse-over */
.navbar a:hover {
  background: #ddd;
  color: black;
}

/* Main content */
.main {
  margin-top: 60px;
  font-family: -apple-system, "Helvetica Neue", Helvetica, sans-serif;
  /* font-size: clamp(1rem, 2.5vw, 2rem); */
  -webkit-font-smoothing: antialiased;
  font-style: normal;
  font-weight: 400;
  letter-spacing: -0.0025em;
  line-height: 1.4;
  min-height: 100vh;
  /* place-items: center; */
  text-rendering: optimizeLegibility;
  -webkit-text-size-adjust: 100%;
}

.grid-container {
  display: grid;
  grid-template-columns: 50%  50%;
  margin: 20px;
  gap: 20px;
}
.grid-item {
}

.line {
  margin : 20px;
}

    .main a {
        color: #ddd;
    }

    .grid-membership-container {
      display: grid;
      grid-template-columns: 50% 50%;
      margin: 0px;
      gap: 20px;
    }
    .grid-membership-item {
    }

    .table-container {
        max-height: 500px;
        overflow-y: auto;
    }
    table {
        border-collapse: collapse;
    }
    thead, tbody {
    }
    thead {
    }
    tbody {
        max-height: 450px;
        overflow-y: auto;
    }
    td {
        padding: 3px;
        text-align: left;
        border: 1px solid #ddd;
        box-sizing: border-box;
        color: #ddd;
        background-color: #2559a7
    }
    th{
        padding: 3px;
        text-align: left;
        border: 1px solid #ddd;
        box-sizing: border-box;
        background-color: #ddd;
        color: #2559a7
    }
    .rowpadded {
        height:20px;
    }
    .column75 {
        float: left;
        width: 75%;
    }
    .column90 {
        float: left;
        width: 90%;
    }
    .column25 {
        float: left;
        width: 25%;
    }
    .column10 {
        float: left;
        width: 10%;
    }

  .block {
    border: 1px;
    background: #033684;
    color: white;
    padding: 5px 10px;
    font-size: 16px;
    cursor: pointer;
    text-align: center;
    text-decoration: none;
  }

  .block:hover {
    background: #ddd;
    color: black;
  }

</style>

<script>
</script>

<div>
  <div class="navbar">
    <a href="/">Welcome</a>
    <a href="/activeEvents">Active Events</a>
    <a href="/recurringEvents">Recurring Events</a>
    <a href="/archives">Archives</a>
    <a href="/sections"><b>Sections</b></a>
    <a href="/operators">Operators</a>
    <a href="/locations">Locations</a>
  </div>
  <div class="main">
    <div><hr/></div>
    <div style="margin:20px;">
    <h1>Section Details - {{section.name}}</h1>
    <p>View properties of a section, including its members.
    <div class="line" style="margin:0px"><hr/></div>
    </div>
    <div class="table-container" style="margin:20px;">
      <div>
        <p><b>Name</b>:
        {{section.name}}
      </div>
      <div>
        <p><b>Description</b>:
        {{section.description}}
      </div>
    </div>

    <div class="grid-membership-container"  style="margin:20px;">
      <div class="grid-membership-item">
        <b>Districts ({{districtsCount}} total)</b> <a href='/district-add/{{section.id}}'><b>Add</b></a>
        <div class="table-container">
          <table id="members-list">
            <thead>
              <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Leader name</th>
                <th>Leader Contact</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              {{#each districts}}
                <tr id="{{id}}">
                  <td>{{name}}</td>
                  <td>{{description}}</td>
                  <td>{{leaderName}}</td>
                  <td>{{leaderContact}}</td>
                  <td><a href="/district/{{id}}">Details</a>&nbsp;<a href="/district-remove/{{id}}">Delete</a></td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      </div>
      <div class="grid-membership-item">
        <b>Operators ({{operatorCount}} total)</b>
        <div class="table-container">
          <table id="members-list">
            <thead>
              <tr>
                <th>Callsign</th>
                <th>Name</th>
                <th>Type</th>
                <th>NTS?</th>
                <th>Skywarn?</th>
                <th>Location</th>
              </tr>
            </thead>
            <tbody>
              {{#each operators}}
                <tr id="{{id}}">
                  <td>{{callsign}}</td>
                  <td>{{name}}</td>
                  <td>{{membershipType}}</td>
                  <td>{{isNTS}}</td>
                  <td>{{isSkywarn}}</td>
                  <td>
                    {{location.name}}
                    {{#if location.county.name}}
                    ({{location.county.name}} County)
                    {{else}}
                    {{/if}}
                    {{location.state.abbreviation}} {{location.country.abbreviation}}
                  </td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div style="margin:20px">
      <div class="line" style="margin:0px;"><hr/></div>
      <a class="block" href="/section-monthlyreport/{{section.id}}">Generate monthly summary report</a>&nbsp;
      <a class="block" href="/section-monthlyparticipationreport/{{section.id}}">Generate monthly participation report</a>&nbsp;
      <a class="block" href="/section-monthlynonparticipationreport/{{section.id}}">Generate monthly non-participation report</a>&nbsp;
      <p>
      <a class="block" href="/section-quarterlyreport/{{section.id}}">Generate quarterly summary report</a>&nbsp;
      <a class="block" href="/section-quarterlyparticipationreport/{{section.id}}">Generate quarterly participation report</a>&nbsp;
      <a class="block" href="/section-quarterlynonparticipationreport/{{section.id}}">Generate quarterly non-participation report</a>&nbsp;
      <p>
      <a class="block" href="/section-memberreport/{{section.id}}">Generate member report</a>&nbsp;
      <a class="block" href="/section-leadershipreport/{{section.id}}">Generate leadership report</a>&nbsp;
      <a class="block" href="/section-ntsreport/{{section.id}}">Generate NTS member report</a>&nbsp;
      <a class="block" href="/section-racesreport/{{section.id}}">Generate RACES member report</a>&nbsp;
      <a class="block" href="/section-skywarnreport/{{section.id}}">Generate Skywarn member report</a>&nbsp;
      <p>
      <a class="block" href="/section-monthlyexport/{{section.id}}">Export monthly data</a>&nbsp;
      <a class="block" href="/section-monthlynonparticipationexport/{{section.id}}">Export monthly non-participation data</a>&nbsp;
      <a class="block" href="/section-quarterlynonparticipationexport/{{section.id}}">Export quarterly non-participation data</a>&nbsp;
      <p>
      <a class="block" href="/section-edit/{{section.id}}">Edit details</a>&nbsp;
      <a class="block" href="/section-delete/{{section.id}}">Delete</a>
      <a class="block" href="/sections">Close</a>
    </div>
  </div>
  </div>
</div>

</body>
</html>